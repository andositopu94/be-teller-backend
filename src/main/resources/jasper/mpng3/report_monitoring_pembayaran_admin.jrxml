	<parameter name="periode" class="java.lang.String"/>
	<parameter name="whereClause" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="outerWhereClause" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    'TELLER' as CHANNEL,
    MESSAGE,
    TRACE_NUMBER,
    BRANCH_CODE,
    TO_CHAR(TRANSACTION_DATE, 'DD-MM-YYYY HH24:MI:SS') as TRANSACTION_DATE,
    USER_ID,
    SETTLEMENT_DATE,
    BILLING_CODE,
    CASE
        WHEN TRX_TYPE = 'djpg3' OR TRX_TYPE = 'djp' THEN TAX_NAME
        ELSE CUSTOMER_NAME
    END as NAMA,
    NVL(NTPN, '-') as NTPN,
    ARCHIVE_NUMBER,
    NVL(NOMINAL, '0') as NOMINAL,
    LPAD(NTB, 12, '0') as NTB,
    STS,
    NVL(NPWP, '-') as NPWP
from
(
SELECT "TRACE_NUMBER","BRANCH_CODE","MESSAGE","TRANSACTION_DATE","USER_ID","STS","TRX_TYPE","SETTLEMENT_DATE",
"BILLING_CODE","TAX_NAME","CUSTOMER_NAME","NTPN","ARCHIVE_NUMBER","NOMINAL","NTB","NPWP","TAX_ADDRESS","COUNT_DETAIL"
  FROM (
    SELECT
      TRACE_NUMBER                AS trace_number,
      BRANCH_CODE                 AS branch_code,
      MESSAGE                     AS message,
      STATUS                      AS status_log,
      FIELD_NAME,
      FIELD_VALUE,
      TRX_DATE                    AS transaction_date,
      USERID                      AS user_id,
      RC                          AS rc,
      CASE WHEN RC = '00'
        THEN 'SETTLEMENT'
      ELSE 'UNCATEGORIZED' END AS sts,
      TRX_TYPE
    FROM TRANSACTION_LOG trx
      JOIN COMMON_TRANSACTION_LOG log
        ON trx.COMMON_TRANSACTION_ID = log.ID
    WHERE (
    trx.TRX_TYPE IN ('djag3', 'djpg3', 'djbcg3', 'djp', 'dja', 'djbc') OR 
    (trx.TRX_TYPE IN ('djag3Reinquiry', 'djpg3Reinquiry', 'djbcg3Reinquiry') AND RC = '00'))
    $P!{whereClause}
  )
    PIVOT (
      listagg(FIELD_VALUE, ', ')
      WITHIN GROUP (
        ORDER BY FIELD_VALUE)
      FOR
        FIELD_NAME
      IN (
        'settlementDate' AS settlement_date,
        'billingCode' AS billing_code,
        'taxName' AS tax_name,
        'payCustomerName' AS customer_name,
        'ntpn' AS ntpn,
        'archiveNumber' AS archive_number,
        'nominal' AS nominal,
        'ref' AS ntb,
        'taxNumber' AS npwp,
        'taxAddress' AS tax_address,
        'countDetail' AS count_detail
      ))
)
WHERE BILLING_CODE NOT LIKE '-%'
$P!{outerWhereClause}
ORDER BY TO_DATE(TRANSACTION_DATE, 'DD-MM-YYYY HH24:MI:SS'), BRANCH_CODE, BILLING_CODE]]>
	</queryString>
